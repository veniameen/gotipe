{
  "name": "@gotipe/theme",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./base.css": "./src/base.css",
    "./theme.css": "./src/theme.css",
    "./page.css": "./src/page.css",
    "./tokens.css": "./src/tokens.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@gotipe/core": "^0.1.0"
  },
  "devDependencies": {
    "@gotipe/core": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "license": "SEE LICENSE IN LICENSE-COMMERCIAL",
  "files": [
    "dist",
    "src/**/*.css",
    "LICENSE-COMMERCIAL"
  ],
  "publishConfig": {
    "access": "public"
  }
}
