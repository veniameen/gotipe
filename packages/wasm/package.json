{
  "name": "@gotipe/wasm",
  "version": "0.1.2",
  "description": "Rust document engine of the GoTipe editor compiled to WebAssembly, loaded by @gotipe/core.",
  "keywords": [
    "gotipe",
    "editor",
    "wasm",
    "webassembly",
    "rust",
    "crdt",
    "collaboration"
  ],
  "type": "module",
  "main": "./pkg/gotipe_wasm.js",
  "types": "./pkg/gotipe_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/gotipe_wasm.d.ts",
      "node": "./node.js",
      "import": "./pkg/gotipe_wasm.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "sideEffects": false,
  "files": [
    "node.js",
    "pkg/gotipe_wasm.js",
    "pkg/gotipe_wasm_bg.wasm",
    "pkg/gotipe_wasm.d.ts",
    "pkg/gotipe_wasm_bg.wasm.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "test": "node tests/integrity.mjs && node tests/node-entry.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veniameen/gotipe.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://gotipe.com",
  "bugs": {
    "url": "https://github.com/veniameen/gotipe/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
