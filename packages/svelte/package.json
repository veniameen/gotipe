{
  "name": "@gotipe/svelte",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "@gotipe/core": "^0.1.0",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@gotipe/core": "workspace:*",
    "svelte": "^5.57.3",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
