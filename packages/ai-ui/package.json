{
  "name": "@gotipe/ai-ui",
  "version": "0.1.1",
  "description": "React components for the GoTipe AI layer: a command palette, an action toolbar and controlled ghost text.",
  "keywords": [
    "gotipe",
    "editor",
    "ai",
    "react",
    "command-palette"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "@gotipe/ai": "^0.1.0",
    "@gotipe/core": "^0.1.0",
    "@gotipe/react": "^0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@gotipe/ai": "workspace:*",
    "@gotipe/core": "workspace:*",
    "@gotipe/i18n": "workspace:*",
    "@gotipe/react": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "license": "SEE LICENSE IN LICENSE-COMMERCIAL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veniameen/gotipe.git",
    "directory": "packages/ai-ui"
  },
  "homepage": "https://gotipe.com",
  "bugs": {
    "url": "https://github.com/veniameen/gotipe/issues"
  },
  "files": [
    "dist",
    "LICENSE-COMMERCIAL"
  ],
  "publishConfig": {
    "access": "public"
  }
}
