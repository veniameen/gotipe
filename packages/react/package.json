{
  "name": "@gotipe/react",
  "version": "0.1.4",
  "description": "React adapter for the GoTipe editor: hooks, document renderer, bubble and floating menus.",
  "keywords": [
    "gotipe",
    "editor",
    "react",
    "rich-text",
    "headless",
    "block-editor"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@gotipe/i18n": "workspace:^"
  },
  "peerDependencies": {
    "@gotipe/core": "^0.1.4",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@gotipe/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --environment jsdom --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veniameen/gotipe.git",
    "directory": "packages/react"
  },
  "homepage": "https://gotipe.com",
  "bugs": {
    "url": "https://github.com/veniameen/gotipe/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
