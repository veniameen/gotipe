{
  "name": "@gotipe/block-editor",
  "version": "0.1.3",
  "description": "Ready React UI for GoTipe: BlockEditor with slash menu and block handle, and the Markdown PageEditor.",
  "keywords": [
    "gotipe",
    "editor",
    "block-editor",
    "react",
    "notion",
    "markdown",
    "rich-text"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shiki": {
      "types": "./dist/shiki.d.ts",
      "import": "./dist/shiki.js",
      "require": "./dist/shiki.cjs"
    },
    "./styles": "./styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@gotipe/core": "^0.1.3",
    "@gotipe/i18n": "^0.1.3",
    "@gotipe/markdown": "^0.1.2",
    "@gotipe/react": "^0.1.3",
    "@gotipe/suggestions": "^0.1.2",
    "@gotipe/theme": "^0.1.3",
    "@gotipe/versions": "^0.1.1",
    "react": ">=18",
    "react-dom": ">=18",
    "shiki": "^1.22.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gotipe/core": "workspace:*",
    "@gotipe/i18n": "workspace:*",
    "@gotipe/markdown": "workspace:*",
    "@gotipe/react": "workspace:*",
    "@gotipe/suggestions": "workspace:*",
    "@gotipe/theme": "workspace:*",
    "@gotipe/versions": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^1.29.2",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "license": "SEE LICENSE IN LICENSE-COMMERCIAL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veniameen/gotipe.git",
    "directory": "packages/block-editor"
  },
  "homepage": "https://gotipe.com",
  "bugs": {
    "url": "https://github.com/veniameen/gotipe/issues"
  },
  "files": [
    "dist",
    "styles.css",
    "LICENSE-COMMERCIAL"
  ],
  "publishConfig": {
    "access": "public"
  }
}
