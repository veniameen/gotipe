{
  "name": "@gotipe/core",
  "version": "0.1.6",
  "description": "Headless core of the GoTipe editor: document model, transactions, commands, events and extensions.",
  "keywords": [
    "gotipe",
    "editor",
    "rich-text",
    "block-editor",
    "headless",
    "wysiwyg",
    "markdown"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./js": {
      "types": "./dist/js.d.ts",
      "import": "./dist/js.js",
      "require": "./dist/js.cjs"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js",
      "require": "./dist/extensions/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./server": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.cjs"
    },
    "./menus": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./emoji": {
      "types": "./dist/emoji.d.ts",
      "import": "./dist/emoji.js",
      "require": "./dist/emoji.cjs"
    },
    "./emoji/ru": {
      "types": "./dist/emoji/ru.d.ts",
      "import": "./dist/emoji/ru.js",
      "require": "./dist/emoji/ru.cjs"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js",
      "require": "./dist/math.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "@gotipe/wasm": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@gotipe/wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gotipe/wasm": "workspace:*",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veniameen/gotipe.git",
    "directory": "packages/core"
  },
  "homepage": "https://gotipe.com",
  "bugs": {
    "url": "https://github.com/veniameen/gotipe/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gotipe/markdown": "workspace:*"
  }
}
