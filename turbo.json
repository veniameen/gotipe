{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@gotipe/wasm#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "pkg/**"
      ]
    },
    "@gotipe/export-wasm#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "pkg/**"
      ]
    },
    "@gotipe/landing#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs-site/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "public/docs/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
