{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@gotipe/wasm#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "pkg/**"
      ]
    },
    "@gotipe/export-wasm#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "pkg/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
