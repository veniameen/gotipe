# ============================================================
# GoTipe Cloud — environment for infra/docker-compose.yml
# ============================================================
# Copy to infra/.env and replace every CHANGE_ME and example.com value.
# Compose reads this file for its own ${VARIABLES} and passes it to the API.
# The names and formats are the API's own (apps/cloud/internal/config);
# env_example_test.go there loads this file through that loader, so it
# cannot drift.
#
# Durations are Go durations (30s, 15m, 1h). Rate limits are
# <count>/<s|sec|min|h|hour>. An invalid value stops the API at startup.
# Keep comments on their own lines: a value runs to the end of its line.

# --- Server ---
ENVIRONMENT=production
LISTEN_ADDR=:8080
SYNC_LISTEN_ADDR=:8081
METRICS_LISTEN_ADDR=:9090
# Exact browser origins, comma separated; wildcards are rejected.
HTTP_ALLOWED_ORIGINS=https://app.example.com
SYNC_ALLOWED_ORIGINS=https://app.example.com
# Reverse proxies whose X-Forwarded-For names the client for the login rate
# limit: IP addresses or CIDR ranges, comma separated. Empty trusts no proxy.
# docker-compose.yml sets it to Caddy's fixed address (172.30.240.2/32).
# TRUSTED_PROXIES=

# --- PostgreSQL ---
# Used by docker-compose.yml for the postgres and pgbouncer services.
POSTGRES_PASSWORD=CHANGE_ME
# docker-compose.yml sets DATABASE_URL to PgBouncer itself. Migrations bypass
# PgBouncer: infra/scripts/deploy.sh runs them against postgres:5432.
DATABASE_URL=postgres://gotipe:${POSTGRES_PASSWORD}@pgbouncer:6432/gotipe?sslmode=disable
DATABASE_MAX_CONNS=50
DATABASE_IDLE_CONNS=10

# --- Valkey ---
# Token revocations, idempotency records and rate limits. The server must not
# evict keys: infra/valkey/valkey.conf uses maxmemory-policy noeviction.
VALKEY_URL=redis://valkey:6379/0
VALKEY_PASSWORD=

# --- Object storage: Cloudflare R2 or another S3 API ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=gotipe-data
# For MinIO or another S3 service set S3_ENDPOINT instead of R2_ACCOUNT_ID;
# the access key variables keep their R2_ names.
# S3_ENDPOINT=http://minio:9000
# S3_USE_PATH_STYLE=true

# --- Access tokens (ES256) ---
# Required: the PEM text of a matching ECDSA P-256 pair, not file paths.
# Append both as quoted multi-line values:
#   printf 'JWT_PRIVATE_KEY="%s"\nJWT_PUBLIC_KEY="%s"\n' "$(cat jwt-private.pem)" "$(cat jwt-public.pem)" >> infra/.env
# JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
JWT_ISSUER=gotipe
JWT_AUDIENCE=gotipe-cloud
JWT_EXPIRY=1h

# --- AI proxy ---
# A provider without a key is unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096

# --- Export jobs ---
# Parallel export jobs, 1-16.
EXPORT_WORKERS=2
EXPORT_POLL_INTERVAL=1s
# Largest document body in bytes, at most 64 MiB (67108864).
EXPORT_MAX_DOCUMENT_SIZE=10485760
EXPORT_R2_PREFIX=exports/
# The image runs gotipe-convert from PATH; set a path only for another build.
# GOTIPE_EXPORT_COMMAND=/usr/local/bin/gotipe-convert

# --- Rate limits ---
RATE_LIMIT_API=100/min
RATE_LIMIT_WS=1000/min
RATE_LIMIT_AI=60/min

# --- Stripe (optional; billing answers 503 without it) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_BUSINESS_ID=

# --- Logs and metrics ---
PROMETHEUS_ENABLED=true
# debug, info, warn or error
LOG_LEVEL=info
# json or text
LOG_FORMAT=json
# Grafana admin password for the monitoring profile.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
