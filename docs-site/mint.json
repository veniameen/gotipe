{
  "$schema": "https://mintlify.com/schema.json",
  "name": "GoTipe",
  "logo": {
    "dark": "/images/logo-dark.svg",
    "light": "/images/logo-light.svg"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#1d4ed8"
  },
  "topbarLinks": [
    { "name": "GitHub", "url": "https://github.com/gotipe/gotipe" }
  ],
  "topbarCtaButton": {
    "name": "Playground",
    "url": "https://playground.gotipe.com"
  },
  "tabs": [
    { "name": "Guides", "url": "guides" },
    { "name": "API Reference", "url": "api-reference" },
    { "name": "SDKs", "url": "sdks" }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": ["introduction", "quickstart"]
    },
    {
      "group": "Guides",
      "pages": [
        "guides/extensions",
        "guides/react",
        "guides/vue",
        "guides/svelte",
        "guides/solid",
        "guides/collaboration",
        "guides/comments",
        "guides/versions",
        "guides/ai",
        "guides/export",
        "guides/theming",
        "guides/i18n",
        "guides/self-hosted",
        "guides/cloud",
        "guides/security"
      ]
    },
    {
      "group": "Migration",
      "pages": [
        "migration/from-tiptap",
        "migration/from-prosemirror",
        "migration/from-lexical",
        "migration/from-slate"
      ]
    },
    {
      "group": "API Reference",
      "pages": ["api-reference/overview"]
    }
  ],
  "api": {
    "baseUrl": "https://api.gotipe.com/v1",
    "auth": {
      "method": "bearer"
    }
  },
  "openapi": "apps/cloud/api/openapi.yaml",
  "footerSocials": {
    "github": "https://github.com/gotipe/gotipe",
    "x": "https://x.com/gotipe_editor"
  },
  "analytics": {
    "plausible": {
      "domain": "docs.gotipe.com"
    }
  }
}
