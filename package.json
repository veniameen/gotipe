{
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:export-wasm": "bash scripts/build-export-wasm.sh",
    "build:converter": "cargo build --locked -p gotipe-export --features pdf,docx,cli --bin gotipe-convert --release --jobs 2",
    "clean": "turbo run clean && cargo clean",
    "check:packages": "node scripts/check-packages.mjs",
    "check:exports": "node scripts/validate-export-formats.mjs",
    "check:docs-site": "node --test scripts/docs-site/rules.test.mjs && node scripts/check-docs-site.mjs",
    "generate:theme": "node scripts/generate-theme.mjs",
    "check:theme": "node scripts/generate-theme.mjs --check",
    "check:architecture": "node --test scripts/quality/architecture.test.mjs && node scripts/quality/architecture.mjs",
    "check:architecture:release": "node scripts/quality/architecture.mjs --release",
    "check:bundles": "node --test scripts/quality/bundle-graph.test.mjs && node scripts/check-bundle-sizes.mjs",
    "check:cargo-release": "node scripts/check-cargo-release.mjs",
    "check:consumer": "node scripts/check-package-consumer.mjs",
    "check:pdf-regression": "GOTIPE_PDF_CORPUS_OUTPUT=\"$PWD/output/pdf-native-corpus\" cargo test --locked -p gotipe-export --features pdf --test pdf_corpus_contract --jobs 2 && node scripts/pdf-regression.mjs --native-dir output/pdf-native-corpus --out output/pdf-regression"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.65.0",
    "tsup": "^8.5.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23",
      "tsup>esbuild": "^0.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
